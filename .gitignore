# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Build outputs
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Bun
bun.lockb
.bun/

# ============================================
# IDE / Editor
