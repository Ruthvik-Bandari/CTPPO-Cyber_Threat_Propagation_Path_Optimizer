# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.lnk

# ============================================
# Environment & Secrets
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
secrets/
.secrets

# ============================================
# ML / Data Files
# ============================================
# Large data files
data/raw/
data/processed/
data/*.csv
data/*.json
data/*.parquet
!data/.gitkeep

# Model files (keep structure, ignore large files)
models/**/*.pt
models/**/*.pth
models/**/*.h5
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
!models/**/.gitkeep
!models/**/config.json

# Checkpoints
checkpoints/
*.ckpt

# ============================================
# Logs & Temporary Files
# ============================================
logs/
*.log
tmp/
temp/
.tmp/
*.tmp

# ============================================
# Docker
# ============================================
.docker/

# ============================================
# Testing
# ============================================
.coverage
coverage/
.nyc_output/

# ============================================
# Misc
# ============================================
*.bak
*.backup
*.old
*.orig
.cache/

# ============================================
# Project Specific
# ============================================
# Database files
*.db
*.sqlite
*.sqlite3

# Report outputs
reports/*.pdf
reports/*.html

# Scan results
scan_results/

# NVD cache
nvd_cache/
cve_cache/
