cff-version: 1.2.0
message: "If you use CTPPO in your work, please cite it as below."
title: "CTPPO: Cyber Threat Propagation Path Optimizer"
abstract: >-
  Exact multi-objective (NAMOA*) attack-path search over cyber attack graphs,
  with edge costs grounded in FIRST EPSS, the CISA KEV catalog and CVSS v3.1
  sub-scores computed from specification.
type: software
authors:
  - family-names: Bandari
    given-names: Ruthvik Nath
    affiliation: "Northeastern University"
repository-code: "https://github.com/Ruthvik-Bandari/CTPPO-Cyber_Threat_Propagation_Path_Optimizer"
license: Apache-2.0
keywords:
  - attack-graph
  - multi-objective-optimization
  - pareto-optimality
  - vulnerability-prioritization
references:
  - type: conference-paper
    title: "A New Approach to Multiobjective A* Search"
    authors:
      - family-names: Mandow
        given-names: Lawrence
      - family-names: "Pérez de la Cruz"
        given-names: "José Luis"
    collection-title: "Proceedings of IJCAI"
    year: 2005
